#!/usr/bin/env python3
# 1. Summary: Executable shell launcher for the python backtesting system.
# 2. Description: Ignores parent wrapper SIGINT signals so the child backtest process can handle key interrupts gracefully, print final reports, and exit without corruption. Runs backtest.py with all CLI arguments passed.
# 3. Context: Dependent on backtest.py. Uses subprocess and sys.executable to run.
import sys, subprocess, os, signal
if __name__ == "__main__":
    # Ignore SIGINT in the parent wrapper so that the child python process
    # handles KeyboardInterrupt, prints final tables, and exits gracefully.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    cmd = [sys.executable, "backtest.py"] + sys.argv[1:]
    subprocess.run(cmd)
